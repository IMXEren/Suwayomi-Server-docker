# Copy to .env and adjust. Never commit .env or anything under ./secrets.
# Credentials do NOT belong here: rclone.conf and auth_password are files under ./secrets.

# Image built by this repository's release workflow.
# `:stable` tracks main releases, `:dev` tracks dev prereleases.
SUWAYOMI_IMAGE=ghcr.io/imxeren/suwayomi-server:stable
TZ=Etc/UTC
AUTH_MODE=UI_LOGIN
AUTH_USERNAME=admin

# Local data root (H2 database, downloads, staging). Keep it on local disk, never on
# the archive mount.
DATA_HOST_PATH=./data

# Direct rclone remote spec, used by BOTH the mount sidecar and the app's
# lsjson/link verification. Must match a remote in ./secrets/rclone.conf.
# Example: suwayomi-b2:suwayomi/archive
RCLONE_REMOTE=suwayomi-b2:suwayomi/archive

# Host directory bind-mounted (rshared) into the rclone sidecar and into Suwayomi.
ARCHIVE_HOST_PATH=/srv/suwayomi/archive

# rclone VFS cache tuning.
RCLONE_VFS_CACHE_MAX_SIZE=50G
RCLONE_VFS_CACHE_MAX_AGE=168h
RCLONE_VFS_WRITE_BACK=10s
RCLONE_DIR_CACHE_TIME=10m
RCLONE_LOG_LEVEL=INFO

# Cloudflare challenge solver, started by default and enabled in the app.
# Set to false to turn the integration off (the container can stay stopped).
FLARESOLVERR_ENABLED=true

# Prowl replaces FlareSolverr/Byparr with a real browser that owns a persistent trust
# profile. Build Prowl v1.2.0-dev.1 or newer locally as prowl:local before starting
# Compose; Prowl does not publish container images. Its egress uses the app's hop.
PROWL_IMAGE=prowl:local
# Chromium allocates from /dev/shm; 512m matches the app container.
PROWL_SHM_SIZE=512m
# Per-host egress. egress-hop routes each destination host through one of the named SOCKS5
# upstreams authored in ./secrets/egress-upstreams.json (any provider; the optional WARP bridge is
# just another upstream), and is the single switch for the app and for Prowl, so both must use the
# same host and port. Hosts in egress-rules/direct-hosts.txt are hand-edited policy and leave with
# no upstream. Credentials live in that secrets file, never in .env. Create and fill it before the
# first `up`; see docs/DEPLOY.md.
SOCKS_PROXY_ENABLED=true
SOCKS_PROXY_HOST=egress-hop
SOCKS_PROXY_PORT=1080
# The prober probes the configured preferred upstream (WARP when set as preferred) first for every
# host and keeps a paid assignment only while the preferred one cannot serve it. One hour is
# plenty: an egress that starts refusing a host is repaired on the next pass, and shorter only
# adds probes.
EGRESS_PROBER_INTERVAL_SECONDS=3600
# A few concurrent loads, so an interactive WebView does not starve the app's own solves.
PROWL_MAX_CONCURRENCY=6
# Interactive tabs with no activity are reaped after this many seconds. The app's tab poll counts
# as activity, so a displayed tab stays alive and a forgotten one is collected.
PROWL_INTERACTIVE_IDLE_SECONDS=300

# VNC surface for the browser display. The web client is reachable on the compose network
# only; the app brokers access to it, so no VNC level authentication is configured.
VNC_IMAGE=suwayomi-vnc:local
VNC_WEB_PORT=6080
VNC_DISPLAY_NUM=0
# Window manager image for the display. Without one a window keeps the size it asked for, which
# is larger than the screen, and the right edge and bottom of the browser are clipped.
WM_IMAGE=suwayomi-wm:local
# Size of the virtual display the browser renders into and VNC serves. The client scales the
# framebuffer to the panel, so this is a direct trade of a larger, sharper view against bandwidth:
# 1600x900 carries 31 percent fewer pixels than 1920x1080. Raise it if detail matters more.
DISPLAY_GEOMETRY=1600x900x24
# The headed browser's launch window, kept equal to the display size above (minus the depth) so the
# page lays out at the size actually visible. Left unset, the window keeps the persona fingerprint
# screen, which is larger than the display and clips the right edge and the bottom of the browser.
PROWL_WINDOW_SIZE=1600x900
WARP_PROXY_PORT=40001
WARP_PROXY_SOURCE_PORT=40000

# The WebView egresses through the local http-proxy service. Set the upstream to an
# authenticated ISP/residential proxy to give the WebView a residential address; gost injects the
# credentials, because Chromium cannot send proxy credentials itself. Left unset it uses WARP.
WEBVIEW_PROXY_UPSTREAM=
# Empty means the http-proxy default (http://http-proxy:8118).
SUWAYOMI_HTTP_PROXY=
SUWAYOMI_NO_PROXY=localhost,127.0.0.1,::1,suwayomi-rclone,http-proxy,warp-bridge,backblazeb2.com

# The archival dashboard only exists in this image's bundled WebUI, so the server must
# not replace it with an upstream release. Custom/BUNDLED/0 is the required combination.
WEB_UI_ENABLED=true
WEB_UI_FLAVOR=Custom
WEB_UI_CHANNEL=BUNDLED
WEB_UI_UPDATE_INTERVAL=0

# The embedded Chromium (KCEF). The WebView uses the external browser by default
# (WEB_VIEW_PROVIDER=PROWL_VNC), so CEF is not initialized while that holds; only the CEF path
# needs roughly 0.5 GiB of RAM and the matching shm_size, which is why it is enabled here rather
# than left off.
KCEF_ENABLED=true
SUWAYOMI_SHM_SIZE=512m
BIND_IP=0.0.0.0
BIND_PORT=4567
MAX_SOURCES_IN_PARALLEL=4
